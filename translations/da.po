msgid "Content Hierarchy"
msgstr "Indholdshierarki"

msgid "Provides the functionality to organize nodes in a tree/hierarchy."
msgstr "Tilføjer funktionaliteten til at organisere noder i et træ/hierarki."

msgid "Hierarchy"
msgstr "Hierarki"

msgid "All content"
msgstr "Alt indhold"

msgid "Content tree"
msgstr "Indholdstræ"

msgid "Content sorting"
msgstr "Indholdssortering"

msgid "Content"
msgstr "Indhold"

msgid "Sorting"
msgstr "Sortering"

msgid "Content Hierarchy settings"
msgstr "Indholdshierarki indstillinger"

msgid "Configure how the content hierarchy works and what nodes are included in the hierarchy lists."
msgstr "Konfigurér hvordan indholdshierarkiet virker og hvilke indholdstyper er indkluderet i hierarki lister."

msgid "Settings for the Content Hierarchy module."
msgstr "Indstillinger til Indholdshierarki modulet."

msgid "Hierarchy select"
msgstr "Hierarki vælger"

msgid "A select field sorted by hierarchy tree."
msgstr "Et valg-felt sorteret efter hierarki træ."

msgid "Ignore these nodes on the content lists"
msgstr "Ignorér disse indholdstyper på indholdslisten"

msgid "Content Hierarchy overview"
msgstr "Indholdshierarki oversigt"

msgid "Content Hierarchy pattern"
msgstr "Indholdshierarki mønster"

msgid "Placement: @placement"
msgstr "Placering: @placement"

msgid "Current placement"
msgstr "Nuværende placering"

msgid "Content hierarchy for @language"
msgstr "Indholdstræ for @language"

msgid "Tokens related to individual content items."
msgstr "Symboler relateret til individuelle elementer."

msgid "Hierarchy ancestors joined paths"
msgstr "Herakiske forældres samlede sti"

msgid "Hierarchy ancestors path joined"
msgstr "Herakiske forældres sti samlet"

msgid "Creates url aliases based on content hierarchy"
msgstr "Skaber url aliaser baseret på indholdsherakiet"

msgid "Content per page"
msgstr "Indhold per side"

msgid "How many content items to display per page in sortable overview."
msgstr "Hvor meget indhold skal vises per side i sortingsoversigten."

msgid "Have different content trees for each language."
msgstr "Hav forskellige indholdstræer for hvert sprog."

msgid "Weight for content"
msgstr "Vægt for indhold"

msgid "Content Hierarchy select"
msgstr "Indholdshierarki valgliste"

msgid "A select field sorted by hierarchy tree."
msgstr "En valgliste sorteret efter indholdstræet."

msgid "Content Hierarchy modal"
msgstr "Indholdshierarki modal"

msgid "A widget that opens a modal to select an item in the tree."
msgstr "En widget der åbner en modal til at vælge et punkt i træet."

